# ==============================================================================
# CraftFlow - Environment Variables Template
# Copy this file to .env and fill in required values for local development.
# DO NOT commit real secrets or production .env files to version control.
# ==============================================================================

# Application Settings
APP_NAME="CraftFlow"
BUSINESS_NAME="Your Business"
BUSINESS_DESCRIPTION="A business offering products and services."
BUSINESS_INDUSTRY=general
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# Database (PostgreSQL with pgvector)
POSTGRES_PORT=5435
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5435/ages_art_db

# AI & LLM Provider Configuration
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Logging
LOG_LEVEL=INFO

# Security & CORS (JSON formatted list or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]

# Provider Implementations (mock, hubspot, meta, etc.)
CRM_PROVIDER=mock
WHATSAPP_PROVIDER=mock
VECTOR_DB_PROVIDER=pgvector

# Automation Boundary (n8n)
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=dev_n8n_webhook_secret_placeholder
